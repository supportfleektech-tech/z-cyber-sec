# CYBER-SEC PRODUCTION environment — copy to .env and fill in real values.
#
#   cd infra/prod && cp .env.example.prod .env && edit .env
#
# NEVER commit .env (gitignored). This template is committable on purpose
# (`.gitignore` → `!.env.example.*`) so the prod bring-up is reproducible.
# The boot guard (ADR-006) refuses to start PROD with the dev SECRET_KEY,
# a placeholder (__SET__), or anything under 32 chars.

# --- Identity / secrets (REQUIRED) ---
# ENV_NAME=PROD is what arms the boot guard, the Secure session cookie behind
# TLS, and the environment banner. Do not leave it as LOCAL.
ENV_NAME=PROD
# Strong unique value, e.g. `openssl rand -hex 32`. MUST differ from staging's.
SECRET_KEY=__SET__
TOKEN_TTL_HOURS=4

# --- Public edge (REQUIRED) ---
# Real DNS name that resolves to this host; Caddy obtains the ACME certificate
# for it automatically (HTTP-01, port 80 must be reachable).
PROD_DOMAIN=cybersec.example.org

# --- Internal bind (keep loopback unless you have a reason) ---
# The app is reached through Caddy; 127.0.0.1 means the port is not exposed on
# the host's public interface. /metrics is scraped from here.
INTERNAL_BIND_ADDR=127.0.0.1
INTERNAL_PORT=8080

# --- Hardening (SEC-073) ---
# Login brute-force limiting is ON by default in PROD (50 attempts / 10 s per
# IP, app-enforced). Uncomment to tune or disable.
#LOGIN_RATE_LIMIT_ENABLED=true
#LOGIN_RATE_LIMIT=50
#LOGIN_RATE_LIMIT_WINDOW_S=10

# Optional bearer token for GET /metrics. The prod edge already refuses
# /metrics publicly (Caddyfile → 403); set this if anything beyond the host
# can reach the internal port. Generate with `openssl rand -hex 32`.
#METRICS_TOKEN=__SET_OR_LEAVE_UNCOMMENTED__

# --- Data ---
# Named volume (cybersec-data) mounted at /var/lib/cybersec; set to a host
# path instead if you back up with host tooling. Real data — backups per
# docs/10 (daily + monthly restore drill, SEC-063).
#DATA_DIR=/var/lib/cybersec
