# CYBER-SEC STAGING environment — copy to .env and fill in real values.
# NEVER commit .env (gitignored). The boot guard (ADR-006) refuses to start
# STAGING with the dev SECRET_KEY.

# --- Identity / secrets (REQUIRED) ---
# Strong unique value, e.g. `openssl rand -hex 32`.
# MUST be different from the production SECRET_KEY (environment isolation).
SECRET_KEY=__SET__
TOKEN_TTL_HOURS=4

# --- Network bind (staging LAN) ---
# The staging LAN address on the staging host. Keep 127.0.0.1 if you only
# reach staging through an SSH tunnel.
STAGING_BIND_ADDR=127.0.0.1
STAGING_PORT=8081

# --- Data ---
# Disposable synthetic data. Seeding: run the platform once, then
#   docker compose exec cybersec python -m app.seed.seed_demo
# (or mount a prepared data dir). Staging data must be labeled synthetic —
# it is, by default (X-Data-Class header).
