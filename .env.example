# CYBER-SEC local configuration. Copy to .env — never commit real secrets.
# All values below are safe local defaults; the app runs with no .env at all.
ENV_NAME=LOCAL            # LOCAL | LAB | STAGING | PROD  (drives the UI banner)
PORT=8080
DATA_DIR=./data           # SQLite db + evidence + reports + backups
SECRET_KEY=dev-only-change-me-in-staging  # used for session tokens signing only
TOKEN_TTL_HOURS=12
# Enable in dev only: allow the Vite dev server origin for CORS.
DEV_ORIGIN=http://localhost:5173
